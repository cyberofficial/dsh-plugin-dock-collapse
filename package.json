{
  "name": "dsh-plugin-dock-collapse",
  "version": "0.1.0",
  "private": true,
  "description": "Collapse the composer dock (the turn/step, token, and other chip rows under the chat) into a single one-tap expand control, with the state remembered across reloads",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/client.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
